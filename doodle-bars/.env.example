# live calls iTunes from the runner. fixture points every clip at /api/fixture-tone.
SONG_PREVIEW_MODE=live
# catalog keeps playlist order. Anything else shuffles.
SONG_ORDER=shuffle
GUESS_GRACE_SECONDS=12

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Local dev leaves these unset and uses the file-system runner on http://127.0.0.1:6420.
# Production, on the runner process only:
# RIVET_ENDPOINT=https://<namespace>:sk_…@api.rivet.dev
# RIVET_PUBLIC_ENDPOINT=https://<namespace>:pk_…@api.rivet.dev
# RIVET_RUNNER_VERSION=<commit sha>
# On the Vercel project, the publishable URL only:
# NEXT_PUBLIC_RIVET_ENDPOINT=https://<namespace>:pk_…@api.rivet.dev
