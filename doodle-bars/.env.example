# live calls iTunes from the runner. fixture points every clip at /api/fixture-tone.
SONG_PREVIEW_MODE=live
# catalog keeps playlist order. Anything else shuffles.
SONG_ORDER=shuffle
GUESS_GRACE_SECONDS=12

# PostHog browser analytics configuration.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Room backend. Cloudflare Durable Objects is the default. Set rivet to use the Rivet actor instead.
# NEXT_PUBLIC_ROOM_BACKEND=cloudflare
# Local dev (npm run dev) starts `wrangler dev` on 8787 and points the site at it. Production:
# NEXT_PUBLIC_ROOM_WS_URL=wss://doodle-bars-rooms.<account>.workers.dev
# Vercel only. Same value as the Worker secret PREVIEW_LOOKUP_SECRET.
# PREVIEW_LOOKUP_SECRET=
# Run the Rivet backend locally with: ROOM_BACKEND=rivet npm run dev
#
# Rivet only. Local dev leaves these unset and uses the file-system runner on http://127.0.0.1:6420.
# Production, on the runner process only:
# RIVET_ENDPOINT=https://<namespace>:sk_…@api.rivet.dev
# RIVET_PUBLIC_ENDPOINT=https://<namespace>:pk_…@api.rivet.dev
# RIVET_RUNNER_VERSION=<commit sha>
# On the Vercel project, the publishable URL only:
# NEXT_PUBLIC_RIVET_ENDPOINT=https://<namespace>:pk_…@api.rivet.dev
