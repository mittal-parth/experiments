{
  "name": "doodle-bars",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx dev.ts",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "runner": "NODE_OPTIONS='--conditions=react-server' tsx runner.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p worker",
    "worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "deploy:worker": "wrangler deploy",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "drawably": "^0.4.2",
    "next": "^16.4.0",
    "posthog-js": "^1.438.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "rivetkit": "^2.3.29",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.152.0"
  }
}
